---
import '../styles/global.css';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteTitle = 'Marianna Accerboni';
const pageTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} — Arte, mostre, eventi`;
const desc = description || 'Mostre, presentazioni ed eventi curati da Marianna Accerboni, architetto e critico d’arte.';
---

<!doctype html>
<html lang="it" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={desc} />
    <meta property="og:title" content={title || siteTitle} />
    <meta property="og:description" content={desc} />
    {image && <meta property="og:image" content={new URL(href(image), Astro.site).toString()} />}
    <meta name="theme-color" content="#111316" />
    <script is:inline>
      // The theme is whatever was last chosen with the header switch (saved in the "tema" cookie).
      // First visit: dark.
      (function () {
        var m = document.cookie.match(/(?:^|; )tema=(light|dark)/);
        var theme = m ? m[1] : 'dark';
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'light' ? '#f7f8fa' : '#111316';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <header class="masthead">
      <div class="wrap masthead__bar">
        <a class="logo" href={href('/')} aria-label="Marianna Accerboni, pagina iniziale">
          Marianna Accerboni
        </a>
        <div class="masthead__tools">
        <form class="search" role="search" action={href('/')} method="get" data-search-form>
          <label class="visually-hidden" for="q">Cerca negli eventi</label>
          <svg class="search__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <input
            id="q"
            name="q"
            type="search"
            placeholder="Cerca artisti, mostre, luoghi"
            autocomplete="off"
            enterkeyhint="search"
            data-search-input
          />
          <button type="button" class="search__clear" data-search-clear aria-label="Cancella la ricerca" hidden>
            <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
              <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
        </form>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Passa al tema chiaro" title="Tema chiaro / scuro">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="5" fill="currentColor" />
            <path d="M12 1.8v2.6M12 19.6v2.6M4.2 4.2l1.9 1.9M17.9 17.9l1.9 1.9M1.8 12h2.6M19.6 12h2.6M4.2 19.8l1.9-1.9M17.9 6.1l1.9-1.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20.6 14.6A8.6 8.6 0 1 1 9.4 3.4a7 7 0 0 0 11.2 11.2Z" fill="currentColor" />
          </svg>
        </button>
        </div>
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="colophon">
      <div class="wrap colophon__inner">
        <a class="logo logo--small" href={href('/')}>Marianna Accerboni</a>
        <p>Architetto e critico d’arte. Mostre, presentazioni ed eventi dal 2011.</p>
        <p class="colophon__copy">© {new Date().getFullYear()} Marianna Accerboni</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--text);
    color: var(--bg);
    padding: 8px 12px;
    z-index: 10;
  }

  .skip:focus {
    left: 8px;
  }

  .masthead {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .masthead__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }

  .logo {
    font-family: var(--font-sans);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--text);
  }

  .logo--small {
    font-size: 17px;
  }

  .masthead__tools {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 1 330px;
    min-width: 0;
  }

  .theme-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--line);
  }

  /* show the sun in dark mode (to go light) and the moon in light mode */
  .theme-toggle__moon,
  :global([data-theme='light']) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__moon {
    display: block;
  }

  .search {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .search__icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    height: 40px;
    padding: 0 14px 0 38px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--bg-raised);
    font-size: 14px;
    color: var(--text);
    transition: border-color 0.15s;
  }

  /* iPhone Safari zooms the page when a field under 16px gets focus: keep it at 16px on touch screens */
  @media (pointer: coarse), (max-width: 760px) {
    .search input {
      font-size: 16px;
    }
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .search input:hover {
    border-color: var(--line-strong);
  }

  .search input:focus {
    outline: none;
    border-color: var(--text-2);
  }

  /* one clear button on every device: our own, the browser's is hidden */
  .search input::-webkit-search-cancel-button,
  .search input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .search input {
    padding-right: 40px;
  }

  .search__clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--muted);
    color: var(--bg);
    cursor: pointer;
  }

  .search__clear[hidden] {
    display: none;
  }

  .search__clear:hover {
    background: var(--text-2);
  }

  .colophon {
    margin-top: 120px;
    border-top: 1px solid var(--line);
  }

  .colophon__inner {
    display: grid;
    gap: 6px;
    padding-block: 40px 56px;
    color: var(--muted);
    font-size: 14px;
  }

  .colophon__inner p {
    margin: 0;
  }

  .colophon__copy {
    margin-top: 10px !important;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .masthead__bar {
      height: auto;
      padding-block: 14px;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* phone: switch top right next to the name, search on its own row */
    .masthead__tools {
      display: contents;
    }

    .logo {
      flex: 1 1 auto;
    }

    .theme-toggle {
      order: 1;
      margin-right: -8px;
    }

    .search {
      order: 2;
      flex: 1 1 100%;
    }
  }
</style>

<script>
  // ----- light / dark switch -----
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const apply = (theme: string) => {
    root.dataset.theme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f7f8fa' : '#111316');
    toggle?.setAttribute('aria-label', theme === 'light' ? 'Passa al tema scuro' : 'Passa al tema chiaro');
  };
  apply(root.dataset.theme || 'dark');
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    apply(next);
    // remembered for a year, rewritten at every manual change
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie = `tema=${next}; Max-Age=31536000; Path=/; SameSite=Lax${secure}`;
  });
  // On pages other than the home, the search form simply goes to the home with ?q=.
  // On the home, index.astro listens to the same input and filters live.
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const params = new URLSearchParams(location.search);
  if (input && params.get('q')) input.value = params.get('q') || '';

  // clear button (×): shown while the field has text
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const syncClear = () => { if (clearBtn && input) clearBtn.hidden = !input.value; };
  input?.addEventListener('input', syncClear);
  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    syncClear();
    input.dispatchEvent(new Event('input', { bubbles: true })); // the home list listens to this
    input.focus();
  });
  syncClear();
  window.addEventListener('load', syncClear);
  window.addEventListener('pageshow', syncClear);
</script>
