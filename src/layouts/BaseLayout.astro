---
import { href } from '../lib/url';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const siteTitle = 'Marianna Accerboni';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={href('/')}>{siteTitle}</a>
      <nav class="site-nav">
        <a href={href('/')}>Home</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {siteTitle}. Tutti i diritti riservati.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-text: #1a1a1a;
    --color-muted: #666666;
    --color-accent: #8a6d3b;
    --max-width: 72rem;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #eee;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .site-title {
    font-size: 1.5rem;
    font-weight: bold;
    text-decoration: none;
    color: inherit;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  .site-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .site-footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    border-top: 1px solid #eee;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
</style>
