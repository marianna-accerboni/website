      align-self: end;
      text-align: right;
    }

    .sheet__rows {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .layout__aside + .layout__main {
      margin-top: 48px;
    }

    .layout {
      margin-top: 40px;
    }

    .timeline__item {
      padding-left: 28px;
    }

    .timeline__title {
      font-size: 19px;
    }

    .prose--news {
      font-size: 17px;
      line-height: 27px;
    }

    .lightbox__slide {
      padding: 56px 12px 24px;
    }

    /* on a phone the images are changed by swiping: no arrow buttons */
    .lightbox__prev,
    .lightbox__next {
      display: none !important;
    }
  }

  /* touch screens (tablets too): swipe instead of arrows */
  @media (pointer: coarse) {
    .lightbox__prev,
    .lightbox__next {
      display: none !important;
    }
  }

  .lightbox__figure img {
    touch-action: pan-y pinch-zoom;
  }
</style>

<script>
  // ----- tabs (Notizie / Comunicato stampa), with #notizie / #comunicato deep links -----
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-tab]')];
  function select(id: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.dataset.tab!);
      if (panel) panel.hidden = !on;
      if (on && focus) t.focus();
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      select(t.dataset.tab!);
      history.replaceState(null, '', `#${t.dataset.tab}`);
    });
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next.dataset.tab!, true);
    });
  });
  const hash = location.hash.slice(1);
  if (tabs.length && (hash === 'comunicato' || hash === 'notizie')) select(hash);
  else if (tabs.length && hash && document.getElementById(hash)?.closest('#notizie')) select('notizie');

  // ----- "Tutti gli eventi": back to the same spot in the list -----
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (e) => {
    try { sessionStorage.setItem('eventi-ritorno-attivo', '1'); } catch {}
    const home = new URL((e.currentTarget as HTMLAnchorElement).href);
    const ref = document.referrer ? new URL(document.referrer) : null;
    if (ref && ref.origin === home.origin && ref.pathname === home.pathname && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  });

  // ----- swipe down to close a full-screen sheet (gallery view, image viewer) -----
  function swipeDownToClose(dlg: HTMLDialogElement | null, onlyAtTop: boolean) {
    if (!dlg) return;
    let sx = 0, sy = 0, dragging = false;
    const reset = () => { dlg.style.transition = ''; dlg.style.transform = ''; dlg.style.opacity = ''; };
    dlg.addEventListener('touchstart', (e) => {
      dragging = e.touches.length === 1 && (!onlyAtTop || dlg.scrollTop <= 0);
      sx = e.touches[0].clientX; sy = e.touches[0].clientY;
      dlg.style.transition = 'none';
    }, { passive: true });
    dlg.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      const dx = e.touches[0].clientX - sx, dy = e.touches[0].clientY - sy;
      if (dy > 12 && dy > Math.abs(dx) * 1.4 && (!onlyAtTop || dlg.scrollTop <= 0)) {
        dlg.style.transform = `translateY(${dy * 0.6}px)`;
        dlg.style.opacity = String(Math.max(0.4, 1 - dy / 600));
      }
    }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (!dragging) return;
      dragging = false;
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      dlg.style.transition = 'transform 0.18s ease, opacity 0.18s ease';
      if (dy > 90 && dy > Math.abs(dx) * 1.4 && (!onlyAtTop || dlg.scrollTop <= 0)) {
        dlg.close();
      } else {
        reset();
      }
    }, { passive: true });
    // the browser can take a gesture over (scroll, system swipe) and send "touchcancel" instead of
    // "touchend": never leave the sheet half faded or half moved
    dlg.addEventListener('touchcancel', () => { dragging = false; reset(); }, { passive: true });
    // and always start and finish clean
    dlg.addEventListener('close', () => setTimeout(reset, 200));
    new MutationObserver(() => { if (dlg.open) reset(); }).observe(dlg, { attributes: true, attributeFilter: ['open'] });
  }

  // ----- focused gallery view -----
  const gview = document.querySelector<HTMLDialogElement>('[data-gallery-view]');
  document.querySelectorAll('[data-gallery-open]').forEach((b) =>
    b.addEventListener('click', () => {
      gview?.showModal();
      gview?.scrollTo(0, 0);
    })
  );
  document.querySelector('[data-gallery-close]')?.addEventListener('click', () => gview?.close());
  swipeDownToClose(gview, true);
  // keep the page behind still while a full-screen view is open
  document.querySelectorAll('dialog').forEach((d) => {
    new MutationObserver(() => {
      document.documentElement.style.overflow = document.querySelector('dialog[open]') ? 'hidden' : '';
    }).observe(d, { attributes: true, attributeFilter: ['open'] });
  });

  // ----- zoomed image viewer: gallery images and images inside the texts -----
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  if (dialog) {
    type Item = { src: string; caption: string };
    const galleryEl = document.querySelector('[data-lightbox-data]');
    const galleryItems: Item[] = galleryEl ? JSON.parse(galleryEl.textContent || '[]') : [];
    const slides = dialog.querySelector<HTMLElement>('[data-lightbox-slides]')!;
    const cells = [...slides.querySelectorAll<HTMLElement>('.lightbox__slide')].map((el) => ({
      el,
      img: el.querySelector('img')!,
      cap: el.querySelector('figcaption')!
    }));
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const prev = dialog.querySelector<HTMLElement>('[data-lightbox-prev]')!;
    const next = dialog.querySelector<HTMLElement>('[data-lightbox-next]')!;
    const REST = -100 / 3; // percent of the strip: the middle slide
    let items: Item[] = galleryItems;
    let current = 0;
    let busy = false;
    const at = (i: number) => items[((i % items.length) + items.length) % items.length];
    const place = (x = '') => {
      slides.style.transform = `translateX(calc(${REST}% ${x}))`;
    };
    const fill = () => {
      // previous / current / next; the neighbours are loaded ahead of time
      [-1, 0, 1].forEach((d, k) => {
        const it = at(current + d);
        cells[k].img.src = it.src;
        cells[k].img.alt = it.caption;
        cells[k].cap.textContent = it.caption;
      });
      count.textContent = items.length > 1 ? `${current + 1} / ${items.length}` : '';
      prev.hidden = next.hidden = items.length < 2;
    };
    // after the slide: rotate the three slides instead of swapping their pictures, so the image
    // that was sliding in is already on screen and decoded (no flash of the previous one)
    const settle = (dir: number) => {
      current = (current + dir + items.length) % items.length;
      const c = dir > 0 ? cells.shift()! : cells.pop()!;
      if (dir > 0) { slides.appendChild(c.el); cells.push(c); } else { slides.insertBefore(c.el, slides.firstChild); cells.unshift(c); }
      const it = at(current + (dir > 0 ? 1 : -1));
      c.img.src = it.src;
      c.img.alt = it.caption;
      c.cap.textContent = it.caption;
      slides.style.transition = 'none';
      place();
      count.textContent = `${current + 1} / ${items.length}`;
      busy = false;
    };
    const show = (i: number) => {
      current = ((i % items.length) + items.length) % items.length;
      slides.style.transition = 'none';
      place();
      fill();
    };
    // slide to the previous (-1) or next (+1) image, then settle
    const go = (dir: number) => {
      if (busy || items.length < 2) return;
      busy = true;
      slides.style.transition = 'transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1)';
      slides.style.transform = `translateX(${REST - dir * (100 / 3)}%)`;
      const done = () => {
        slides.removeEventListener('transitionend', done);
        settle(dir);
      };
      slides.addEventListener('transitionend', done);
      setTimeout(() => busy && done(), 400); // safety if no transition fires
    };
    const open = (list: Item[], i: number) => {
      items = list;
      busy = false;
      show(i);
      dialog.showModal();
    };

    // gallery tiles
    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => open(galleryItems, Number(b.dataset.lightbox)))
    );

    // images inside the press release and the news: zoom the ones of the open tab, in reading order
    const bodyImages = [...document.querySelectorAll<HTMLImageElement>('.prose .art-figure img, .timeline__cover')];
    const itemOf = (el: HTMLImageElement): Item => ({
      src: el.currentSrc || el.src,
      caption: el.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || ''
    });
    bodyImages.forEach((el) => {
      el.classList.add('zoomable');
      el.tabIndex = 0;
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', 'Ingrandisci immagine');
      const start = () => {
        const scope = el.closest('.panel') || document;
        const group = bodyImages.filter((x) => scope.contains(x));
        open(group.map(itemOf), group.indexOf(el));
      };
      el.addEventListener('click', start);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); start(); }
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    dialog.addEventListener('click', (e) => {
      // a click on the empty area closes the viewer
      if (!(e.target as HTMLElement).closest('img, figcaption, button')) dialog.close();
    });
    swipeDownToClose(dialog, false);

    // drag sideways: the images follow the finger; release to change image or spring back
    let sx = 0, sy = 0, st = 0, axis: '' | 'x' | 'y' = '', track = false;
    dialog.addEventListener('touchstart', (e) => {
      track = e.touches.length === 1 && !busy;
      axis = '';
      sx = e.touches[0].clientX; sy = e.touches[0].clientY; st = e.timeStamp;
    }, { passive: true });
    dialog.addEventListener('touchmove', (e) => {
      if (!track || items.length < 2) return;
      const dx = e.touches[0].clientX - sx, dy = e.touches[0].clientY - sy;
      if (!axis && (Math.abs(dx) > 8 || Math.abs(dy) > 8)) axis = Math.abs(dx) > Math.abs(dy) * 1.2 ? 'x' : 'y';
      if (axis === 'x') {
        slides.style.transition = 'none';
        place(`+ ${dx}px`);
      }
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (!track || axis !== 'x' || items.length < 2) { track = false; return; }
      track = false;
      const dx = e.changedTouches[0].clientX - sx;
      const speed = Math.abs(dx) / Math.max(1, e.timeStamp - st); // px per ms
      if (Math.abs(dx) > window.innerWidth * 0.22 || (speed > 0.45 && Math.abs(dx) > 30)) {
        // finish the movement from where the finger left it
        busy = true;
        const dir = dx < 0 ? 1 : -1;
        slides.style.transition = 'transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1)';
        slides.style.transform = `translateX(${REST - dir * (100 / 3)}%)`;
        const done = () => {
          slides.removeEventListener('transitionend', done);
          settle(dir);
        };
        slides.addEventListener('transitionend', done);
        setTimeout(() => busy && done(), 400);
      } else {
        slides.style.transition = 'transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1)';
        place();
      }
    }, { passive: true });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
  }
</script>
