  @media (min-width: 1200px) {
    .layout--aside {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--measure) minmax(0, 1fr);
      column-gap: 56px;
      align-items: start;
      max-width: 1400px;
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .layout--aside .layout__aside {
      grid-column: 1;
      justify-self: end;
      position: sticky;
      top: 32px;
      max-width: 248px;
      max-height: calc(100vh - 64px);
      margin: 0;
      padding: 0 4px 0 0;
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .layout--aside .layout__main {
      grid-column: 2;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    /* the sheet, stacked for the narrow column */
    .layout--aside .sheet {
      display: block;
