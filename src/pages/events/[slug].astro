    }

    .layout--aside .tile__time {
      margin-top: 10px;
    }

    .layout--aside .sheet__rows {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      padding-top: 22px;
    }

    .layout--aside .sheet--no-tile .sheet__rows {
      padding-top: 0;
    }

    .layout--aside .sheet__row dd {
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-2);
    }

    .layout--aside .sheet__row--actions {
      padding-top: 4px;
    }

    .layout--aside .sheet__row--actions dd {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .layout--aside .pill {
      padding: 7px 13px;
      font-size: 13px;
    }
  }

  /* ---------- gallery: "+N" tile and focused gallery view ---------- */
  .gallery__count--link {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .gallery__count--link:hover {
    color: var(--text);
  }

  .gallery__more {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .gallery__more img {
    height: 100%;
    object-fit: cover;
    filter: brightness(0.35) saturate(0.6);
  }

  .gallery__more-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
  }

  .gallery__more-num {
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .gallery__more:hover img {
    transform: none;
    filter: brightness(0.45) saturate(0.7);
  }

  .gview {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .gview::backdrop {
