  /* ---------- responsive ---------- */
  @media (max-width: 727px) {
    .head {
      padding-top: 32px;
    }

    .head__venue {
      font-size: 18px;
    }

    .cover {
      margin-top: 32px;
      padding-inline: 0;
    }

    .sheet {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 40px;
    }

    .sheet__tile {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: 16px;
      padding-right: 0;
      padding-bottom: 22px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .sheet--tile-only .sheet__tile {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .sheet__tile .sheet__label {
