    }

    /* day on the left, month and year stacked beside it, time underneath */
    .layout--aside .tile {
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: 12px;
    }

    .layout--aside .tile__day {
      grid-row: span 2;
