---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../lib/url';
import { renderMarkdown, renderInline, renderContacts } from '../../lib/markdown';
import {
  getEvents,
  getSubEvents,
  sortDate,
  yearOf,
  formatDate,
  formatDateShort,
  formatTime,
  formatRange,
  dateTile,
  venueShort,
  excerpt,
  newsDateLabel
} from '../../lib/events';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map(({ entry, number }, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      number,
      newer: i > 0 ? events[i - 1].entry : null,
      older: i < events.length - 1 ? events[i + 1].entry : null
    }
  }));
}

const { entry, number, newer, older } = Astro.props;
const { title, coverImage, info, press, gallerySection } = entry.data;

// ----- info sheet ("Scheda") -----
const opening = info?.openingDate ?? null;
const hasPeriod = !!(info?.periodStart || info?.periodEnd);
const tile = opening ? dateTile(opening) : null;
const tileTime = formatTime(opening);
const rows: { label: string; html: string; wide?: boolean }[] = [];
if (hasPeriod) rows.push({ label: 'Periodo', html: formatRange(info?.periodStart, info?.periodEnd) });
if (info?.venue) rows.push({ label: 'Sede', html: await renderInline(info.venue) });
if (info?.time) rows.push({ label: 'Orario', html: await renderInline(info.time), wide: info.time.length > 60 });
if (info?.curator) rows.push({ label: 'A cura di', html: await renderInline(info.curator), wide: info.curator.length > 60 });
if (info?.hasCatalog) rows.push({ label: 'Catalogo', html: 'Disponibile' });
if (info?.infoContacts) rows.push({ label: 'Info e contatti', html: await renderContacts(info.infoContacts), wide: true });
const invitations = (info?.invitations ?? []).filter(Boolean);
const invitationLabel = (file: string, i: number) => {
  const name = file.split('/').pop()!.replace(/\.[^.]+$/, '');
  if (invitations.length === 1) return 'Scarica l’invito';
  if (/^invito/i.test(name)) return i === 0 ? 'Scarica l’invito' : `Scarica l’invito ${i + 1}`;
  if (/locandina/i.test(name)) return 'Scarica la locandina';
  if (/depliant/i.test(name)) return 'Scarica il depliant';
  if (/volantino/i.test(name)) return 'Scarica il volantino';
  if (/scheda/i.test(name)) return 'Scarica la scheda di partecipazione';
  return `Scarica il documento ${i + 1}`;
};
const hasSheet = !!tile || rows.length > 0 || invitations.length > 0;

// ----- body -----
const pressHtml = await renderMarkdown(press?.pressRelease);
const eventYear = yearOf(sortDate(entry));
const subEvents = await getSubEvents(entry);
const news = await Promise.all(
  subEvents.map(async (s) => ({
    id: s.data.slug,
    title: s.data.title,
    date: newsDateLabel(s.data.title, eventYear),
    cover: s.data.coverImage ? href(s.data.coverImage) : null,
    html: await renderMarkdown(s.data.bodySection?.body)
  }))
);
const hasNews = news.length > 0;
const hasPress = !!pressHtml;

/** Captions that are just a file name ("spacal1", "DSC05225 1600x1200", "IMG 0840") are not shown. */
const realCaption = (c: string) => {
  const t = c.trim();
  if (!t || !/\s/.test(t)) return '';
  if (/^(dsc|img|image|foto|p)[\s_-]?\d+/i.test(t) || /^[\d\s_x-]+$/i.test(t)) return '';
  return t;
};
const gallery = (gallerySection?.gallery ?? []).map((g) => ({
  src: href(g.image),
  caption: realCaption(g.title || g.alt || '')
}));
const shownImages = gallery.length > 10 ? 10 : gallery.length;
const extraImages = gallery.length - shownImages;
const coverCaption = gallery.find((g) => coverImage && g.src === href(coverImage))?.caption || '';

const metaWhen = hasPeriod ? formatRange(info?.periodStart, info?.periodEnd) : formatDate(opening);
const description = excerpt(press?.pressRelease, 160) || title;
---

<BaseLayout title={title} description={description} image={coverImage}>
  <article class="event">
    <header class="measure head">
      <p class="head__kicker">
        <a href={href('/')} class="head__back" data-back>Tutti gli eventi</a>
        <span aria-hidden="true">/</span>
        <span>N° {number}</span>
        {metaWhen && <span class="head__when">{metaWhen}</span>}
      </p>
      <h1 class:list={['head__title', title.length > 110 && 'head__title--long']}>{title}</h1>
      {info?.venue && <p class="head__venue">{venueShort(info.venue)}</p>}
    </header>

    {
      coverImage && (
        <figure class="cover">
          <img src={href(coverImage)} alt={coverCaption || title} decoding="async" fetchpriority="high" />
          {coverCaption && <figcaption>{coverCaption}</figcaption>}
        </figure>
      )
    }

    <div class:list={['layout', hasSheet && 'layout--aside']}>
    {
      hasSheet && (
        <aside class="layout__aside" aria-label="Scheda dell’evento">
          <div class:list={['sheet', !tile && 'sheet--no-tile', rows.length === 0 && 'sheet--tile-only']}>
            {tile && (
              <div class="sheet__tile">
                <p class="sheet__label">{hasPeriod ? 'Inaugurazione' : 'Data'}</p>
                <p class="tile">
                  <span class="tile__day">{tile.day}</span>
                  <span class="tile__month">{tile.month}</span>
                  <span class="tile__year">{tile.year}</span>
                </p>
                {tileTime && <p class="tile__time">{tileTime}</p>}
              </div>
            )}
            {(rows.length > 0 || invitations.length > 0) && (
              <dl class="sheet__rows">
                {rows.map((r) => (
                  <div class:list={['sheet__row', r.wide && 'sheet__row--wide']}>
                    <dt class="sheet__label">{r.label}</dt>
                    <dd set:html={r.html} />
                  </div>
                ))}
                {invitations.length > 0 && (
                  <div class="sheet__row sheet__row--wide sheet__row--actions">
                    <dt class="visually-hidden">Documenti</dt>
                    <dd>
                      {invitations.map((file, i) => (
                        <a class="pill" href={href(file)} target="_blank" rel="noopener">
                          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                            <path d="M8 2v8m0 0 3.2-3.2M8 10 4.8 6.8M3 13h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          {invitationLabel(file, i)}
                        </a>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
            )}
          </div>
        </aside>
      )
    }

    {
      (hasNews || hasPress) && (
        <section class="layout__main body" data-tabs>
          {hasNews && hasPress ? (
            <div class="tabs" role="tablist" aria-label="Contenuti dell’evento">
              <button class="tab" role="tab" id="tab-notizie" aria-controls="notizie" aria-selected="true" data-tab="notizie">
                Notizie <span class="tab__count">{news.length}</span>
              </button>
              <button class="tab" role="tab" id="tab-comunicato" aria-controls="comunicato" aria-selected="false" tabindex="-1" data-tab="comunicato">
                Comunicato stampa
              </button>
            </div>
          ) : (
            <h2 class="tabs tabs--single">
              <span class="tab" aria-selected="true">{hasNews ? 'Notizie' : 'Comunicato stampa'}</span>
            </h2>
          )}

          {hasNews && (
            <div class="panel" id="notizie" role="tabpanel" aria-labelledby="tab-notizie">
              <ol class="timeline">
                {news.map((n) => (
                  <li class="timeline__item" id={n.id}>
                    <div class="timeline__mark" aria-hidden="true" />
                    {n.date && <p class="timeline__date">{n.date}</p>}
                    <h3 class="timeline__title">{n.title}</h3>
                    {n.cover && <img class="timeline__cover" src={n.cover} alt="" loading="lazy" />}
                    {n.html && <div class="prose prose--news" set:html={n.html} />}
                  </li>
                ))}
              </ol>
            </div>
          )}

          {hasPress && (
            <div class="panel" id="comunicato" role="tabpanel" aria-labelledby="tab-comunicato" hidden={hasNews}>
              <div class="prose" set:html={pressHtml} />
            </div>
          )}
        </section>
      )
    }
    </div>

    {
      gallery.length > 0 && (
        <section class="wrap gallery" aria-labelledby="galleria">
          <header class="gallery__head">
            <h2 class="gallery__title" id="galleria">Galleria</h2>
            {extraImages > 0 ? (
              <button type="button" class="gallery__count gallery__count--link" data-gallery-open>
                Vedi tutte le {gallery.length} immagini
              </button>
            ) : (
              <p class="gallery__count">{gallery.length} {gallery.length === 1 ? 'immagine' : 'immagini'}</p>
            )}
          </header>
          <ul class="gallery__grid">
            {gallery.slice(0, shownImages).map((g, i) => (
              <li>
                <button type="button" class="gallery__item" data-lightbox={i} aria-label={g.caption ? `Apri: ${g.caption}` : `Apri immagine ${i + 1}`}>
                  <img src={g.src} alt={g.caption} loading="lazy" decoding="async" />
                </button>
                {g.caption && <p class="gallery__caption">{g.caption}</p>}
              </li>
            ))}
            {extraImages > 0 && (
              <li>
                <button type="button" class="gallery__item gallery__more" data-gallery-open aria-label={`Vedi tutte le ${gallery.length} immagini`}>
                  <img src={gallery[shownImages].src} alt="" loading="lazy" decoding="async" />
                  <span class="gallery__more-label">
                    <span class="gallery__more-num">+{extraImages}</span>
                    <span>Vedi tutte</span>
                  </span>
                </button>
              </li>
            )}
          </ul>
          {extraImages > 0 && (
            <dialog class="gview" data-gallery-view aria-labelledby="gview-title">
              <header class="gview__bar">
                <div class="gview__titles">
                  <p class="gview__kicker">Galleria</p>
                  <h2 class="gview__title" id="gview-title">{title}</h2>
                </div>
                <button type="button" class="gview__close" data-gallery-close>
                  <span aria-hidden="true">←</span> Torna all’evento
                </button>
              </header>
              <ul class="gview__grid">
                {gallery.map((g, i) => (
                  <li>
                    <button type="button" class="gallery__item" data-lightbox={i} aria-label={g.caption ? `Apri: ${g.caption}` : `Apri immagine ${i + 1}`}>
                      <img src={g.src} alt={g.caption} loading="lazy" decoding="async" />
                    </button>
                    {g.caption && <p class="gallery__caption">{g.caption}</p>}
                  </li>
                ))}
              </ul>
            </dialog>
          )}
          <dialog class="lightbox" data-lightbox-dialog aria-label="Galleria">
            <figure class="lightbox__figure">
              <img data-lightbox-img alt="" />
              <figcaption data-lightbox-caption />
            </figure>
            <p class="lightbox__count" data-lightbox-count />
            <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Chiudi">✕</button>
            <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label="Immagine precedente">←</button>
            <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label="Immagine successiva">→</button>
          </dialog>
          <script type="application/json" data-lightbox-data set:html={JSON.stringify(gallery)} />
        </section>
      )
    }

    <nav class="wrap pager" aria-label="Altri eventi">
      {
        older ? (
          <a class="pager__link" href={href(`/events/${older.data.slug}/`)}>
            <span class="pager__label">← Evento precedente</span>
            <span class="pager__title">{older.data.title}</span>
            <span class="pager__date">{formatDateShort(sortDate(older))}</span>
          </a>
        ) : <span />
      }
      {
        newer ? (
          <a class="pager__link pager__link--next" href={href(`/events/${newer.data.slug}/`)}>
            <span class="pager__label">Evento successivo →</span>
            <span class="pager__title">{newer.data.title}</span>
            <span class="pager__date">{formatDateShort(sortDate(newer))}</span>
          </a>
        ) : <span />
      }
    </nav>
  </article>
</BaseLayout>

<noscript>
  <style>
    .panel[hidden] { display: block !important; margin-top: 64px; }
  </style>
</noscript>

<style>
  /* ---------- header ---------- */
  .head {
    padding-top: 56px;
  }

  .head__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 22px;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .head__back {
    text-decoration: none;
    color: var(--text-2);
  }

  .head__back:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .head__when::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 10px 3px 2px;
    border-radius: 50%;
    background: var(--muted);
    vertical-align: middle;
  }

  .head__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(30px, 4.2vw, 42px);
    line-height: 1.16;
    font-weight: 700;
    letter-spacing: -0.026em;
    text-wrap: balance;
  }

  .head__title--long {
    font-size: clamp(26px, 3.2vw, 32px);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .head__venue {
    margin: 18px 0 0;
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.4;
    color: var(--text-2);
  }

  /* ---------- cover ---------- */
  .cover {
    margin: 48px auto 0;
    max-width: calc(var(--wide) + 2 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .cover img {
    margin-inline: auto;
    max-height: 78vh;
    width: auto;
    background: var(--bg-sunken);
  }

  .cover figcaption {
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }

  /* ---------- info sheet ---------- */
  .sheet {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    gap: 0 32px;
    margin-top: 56px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .sheet--no-tile {
    grid-template-columns: minmax(0, 1fr);
  }

  .sheet--tile-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .sheet__label {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sheet__tile {
    padding-right: 28px;
    border-right: 1px solid var(--line);
  }

  .sheet--tile-only .sheet__tile {
    border-right: 0;
  }

  .tile {
    display: grid;
    margin: 4px 0 0;
    line-height: 1;
  }

  .tile__day {
    font-size: 64px;
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .tile__month {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-ink);
  }

  .tile__year {
    margin-top: 4px;
    font-size: 15px;
    color: var(--text-2);
  }

  .tile__time {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--text-2);
  }

  .sheet__rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 32px;
    margin: 0;
    align-content: start;
  }

  .sheet__row {
    min-width: 0;
  }

  .sheet__row--wide {
    grid-column: 1 / -1;
  }

  .sheet__row dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .sheet__row dd :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .sheet__row dd :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .sheet__row--actions dd {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none !important;
    color: var(--text);
  }

  .pill:hover {
    border-color: var(--text-2);
  }

  /* ---------- tabs ---------- */
  .body {
    margin-top: 0;
  }

  .tabs {
    display: flex;
    gap: 32px;
    margin: 0 0 40px;
    border-bottom: 1px solid var(--line);
    font: inherit;
  }

  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: -1px;
    padding: 0 0 16px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
  }

  .tab:hover {
    color: var(--text);
  }

  .tab[aria-selected='true'] {
    color: var(--text);
    border-bottom-color: var(--text);
  }

  .tabs--single .tab {
    cursor: default;
  }

  .tab__count {
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
  }

  .panel[hidden] {
    display: none;
  }

  /* ---------- news timeline ---------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 10px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(var(--line-strong), var(--line-strong) 85%, transparent);
  }

  .timeline__item {
    position: relative;
    padding-left: 40px;
    scroll-margin-top: 24px;
  }

  .timeline__item + .timeline__item {
    margin-top: 64px;
  }

  .timeline__mark {
    position: absolute;
    left: 0;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--text-2);
  }

  .timeline__item:first-child .timeline__mark {
    background: var(--accent);
    border-color: var(--accent);
  }

  .timeline__date {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .timeline__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.016em;
    text-wrap: pretty;
  }

  .timeline__cover {
    margin-top: 24px;
  }

  .prose--news {
    margin-top: 20px;
    font-size: 18px;
    line-height: 29px;
  }

  /* ---------- gallery ---------- */
  .gallery {
    margin-top: 96px;
  }

  .gallery__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 28px;
    margin-bottom: 32px;
    border-top: 1px solid var(--line);
  }

  .gallery__title {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .gallery__count {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 280px;
    column-gap: 24px;
  }

  .gallery__grid li {
    break-inside: avoid;
    margin-bottom: 28px;
  }

  .gallery__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--bg-raised);
    cursor: zoom-in;
    overflow: hidden;
  }

  .gallery__item img {
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s;
  }

  .gallery__item:hover img {
    transform: scale(1.02);
  }

  .gallery__caption {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* ---------- lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px 72px 40px;
    border: 0;
    background: var(--overlay);
    color: var(--text);
  }

  .lightbox::backdrop {
    background: var(--scrim);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 16px;
    max-height: 100%;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: calc(100vh - 160px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox__figure figcaption {
    max-width: 680px;
    font-size: 14px;
    color: var(--text-2);
    text-align: center;
  }

  .lightbox__count {
    position: absolute;
    top: 20px;
    left: 24px;
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .lightbox__btn {
    position: absolute;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    font-size: 16px;
    cursor: pointer;
  }

  .lightbox__btn:hover {
    border-color: var(--text-2);
  }

  .lightbox__close {
    top: 12px;
    right: 16px;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: 16px;
  }

  .lightbox__next {
    right: 16px;
  }

  /* ---------- pager ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
