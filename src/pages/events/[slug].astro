    }

    .tile {
      grid-template-columns: auto auto;
      align-items: end;
      column-gap: 12px;
    }

    .tile__day {
      grid-row: span 2;
      font-size: 56px;
    }

    .tile__month {
      margin-top: 0;
    }

    .tile__time {
