---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitionCard from '../components/ExhibitionCard.astro';
import { useTranslations } from '../i18n/ui';
import { getExhibitions, splitByDate } from '../lib/exhibitions';

const locale = 'en';
const t = useTranslations(locale);
const { upcoming, past } = splitByDate(await getExhibitions(locale));
---

<BaseLayout locale={locale} currentPath={Astro.url.pathname}>
  {
    upcoming.length > 0 && (
      <section>
        <h2>{t('home.comingExhibitions')}</h2>
        <div class="exhibition-grid">
          {upcoming.map((e) => (
            <ExhibitionCard
              slug={e.data.slug}
              title={e.data.title}
              artists={e.data.artists}
              venue={e.data.venue}
              city={e.data.city}
              startDate={e.data.startDate}
              endDate={e.data.endDate}
              coverImage={e.data.coverImage}
              locale={locale}
            />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <h2>{t('home.latestExhibitions')}</h2>
    <div class="exhibition-grid">
      {
        past.map((e) => (
          <ExhibitionCard
            slug={e.data.slug}
            title={e.data.title}
            artists={e.data.artists}
            venue={e.data.venue}
            city={e.data.city}
            startDate={e.data.startDate}
            endDate={e.data.endDate}
            coverImage={e.data.coverImage}
            locale={locale}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }

  .exhibition-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
