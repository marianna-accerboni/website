---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { href } from '../lib/url';

const events = (await getCollection('events', ({ data }) => !data.draft))
  .map((e) => ({
    slug: e.data.slug,
    title: e.data.title,
    coverImage: e.data.coverImage,
    info: e.data.info
  }))
  .sort((a, b) => {
    const ad = a.info?.openingDate?.getTime() ?? 0;
    const bd = b.info?.openingDate?.getTime() ?? 0;
    return bd - ad;
  });

const formatDate = (d?: Date) =>
  d ? d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---

<BaseLayout>
  <section>
    <h2>Eventi</h2>
    <ul class="event-list">
      {
        events.map((e) => (
          <li>
            <a href={href(`/events/${e.slug}/`)}>{e.title}</a>
            {e.info?.venue && <span class="meta"> — {e.info.venue}</span>}
            {e.info?.openingDate && <span class="meta"> ({formatDate(e.info.openingDate)})</span>}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .event-list {
    list-style: none;
    padding: 0;
  }

  .event-list li {
    margin: 0.5rem 0;
  }

  .meta {
    color: var(--color-muted, #666);
  }
</style>
