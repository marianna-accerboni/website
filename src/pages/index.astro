---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitionCard from '../components/ExhibitionCard.astro';
import { getExhibitions, splitByDate } from '../lib/exhibitions';

const { upcoming, past } = splitByDate(await getExhibitions());
---

<BaseLayout>
  {
    upcoming.length > 0 && (
      <section>
        <h2>Prossime mostre</h2>
        <div class="exhibition-grid">
          {upcoming.map((e) => (
            <ExhibitionCard
              slug={e.data.slug}
              title={e.data.title}
              artists={e.data.artists}
              venue={e.data.venue}
              city={e.data.city}
              startDate={e.data.startDate}
              endDate={e.data.endDate}
              coverImage={e.data.coverImage}
            />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <h2>Ultime mostre</h2>
    <div class="exhibition-grid">
      {
        past.map((e) => (
          <ExhibitionCard
            slug={e.data.slug}
            title={e.data.title}
            artists={e.data.artists}
            venue={e.data.venue}
            city={e.data.city}
            startDate={e.data.startDate}
            endDate={e.data.endDate}
            coverImage={e.data.coverImage}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }

  .exhibition-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
