---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { getExhibitions } from '../../lib/exhibitions';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const exhibitions = await getExhibitions('en');
  return exhibitions.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const locale = 'en';
const t = useTranslations(locale);
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, artists, venue, city, startDate, endDate, coverImage, gallery, attachments, videos } = entry.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} locale={locale} currentPath={Astro.url.pathname}>
  <article class="exhibition">
    <h1>{title}</h1>
    <p class="meta">
      <strong>{t('exhibition.artists')}:</strong> {artists.join(', ')}<br />
      <strong>{t('exhibition.venue')}:</strong> {venue}, {city}<br />
      <strong>{t('exhibition.dates')}:</strong>
      {t('exhibition.from')} {formatDate(startDate)}
      {endDate && <span> {t('exhibition.to')} {formatDate(endDate)}</span>}
    </p>

    {coverImage && <img class="cover" src={href(coverImage)} alt={title} />}

    <div class="content">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <section>
          <h2>{t('exhibition.gallery')}</h2>
          <div class="gallery">
            {gallery.map((img) => (
              <img src={href(img)} alt={title} loading="lazy" />
            ))}
          </div>
        </section>
      )
    }

    {
      videos.length > 0 && (
        <section>
          <h2>{t('exhibition.video')}</h2>
          {videos.map((url) => (
            <div class="video-wrapper">
              <iframe src={url} title={title} allowfullscreen loading="lazy" />
            </div>
          ))}
        </section>
      )
    }

    {
      attachments.length > 0 && (
        <section>
          <h2>{t('exhibition.attachments')}</h2>
          <ul>
            {attachments.map((a) => (
              <li>
                <a href={href(a.file)} target="_blank" rel="noopener">{a.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p><a href={href('/')}>&larr; {t('exhibition.backToList')}</a></p>
  </article>
</BaseLayout>

<style>
  .exhibition .meta {
    color: var(--color-muted, #666);
  }

  .cover {
    border-radius: 6px;
    margin: 1rem 0;
  }

  .content {
    max-width: 46rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .gallery img {
    border-radius: 6px;
    display: block;
  }

  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 46rem;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
